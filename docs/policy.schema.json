{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Privsan policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "disable": {"type": "array", "uniqueItems": true, "items": {"enum": ["phone", "email", "id", "ipv4", "ipv6"]}},
    "id_validation": {"enum": ["candidate", "strict"]},
    "strategy": {"enum": ["placeholder", "mask", "hmac"]},
    "hmac_key_env": {"type": "string"},
    "include": {"type": "array", "maxItems": 1024, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "exclude": {"type": "array", "maxItems": 1024, "items": {"type": "string", "minLength": 1, "maxLength": 512}},
    "limits": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "max_file_bytes": {"type": "integer", "minimum": 1, "maximum": 268435456},
        "max_total_bytes": {"type": "integer", "minimum": 1, "maximum": 1073741824},
        "max_files": {"type": "integer", "minimum": 1, "maximum": 100000},
        "max_findings": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "workers": {"type": "integer", "minimum": 1, "maximum": 32}
      }
    },
    "rules": {
      "type": "array", "maxItems": 64,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "pattern", "replacement"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$"},
          "pattern": {"type": "string", "minLength": 1, "maxLength": 4096},
          "replacement": {"type": "string", "minLength": 1, "maxLength": 128},
          "priority": {"type": "integer", "minimum": -1000, "maximum": 1000}
        }
      }
    }
  },
  "$comment": "Runtime also validates UTF-8 byte-length limits, RE2, duplicate JSON keys, unique rule IDs, CSV-safe literal replacements, combined pattern count, glob syntax, max_total >= max_file and the HMAC environment secret. No null values are accepted. This schema is structural; config validate is authoritative."
}
